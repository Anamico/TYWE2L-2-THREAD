# Base sdkconfig defaults for this project, adapted from espressif/esp-matter's
# examples/light/sdkconfig.defaults (Apache-2.0). Trimmed of OTA requestor and
# button settings, since this minimal build has neither. VID/PID are left at
# their CHIP/esp-matter defaults (0xFFF1 / 0x8000) deliberately: see README.md
# "Matter identity" for why this project does not override CONFIG_DEVICE_PRODUCT_ID.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Human-readable product name only (see README.md "Matter identity" — the numeric VID/PID stay on
# the CHIP SDK defaults deliberately). Unverified against connectedhomeip source in this sandbox;
# if this doesn't change what commissioning shows, check via `idf.py menuconfig` -> Component
# config -> CHIP Device Layer -> Device Identification Options on a machine with the real source.
CONFIG_DEVICE_PRODUCT_NAME="HackLight"

# Matter commissioning uses BLE; the H2 has no Wi-Fi radio at all, so BLE is
# the only commissioning transport and Thread is the only operational one.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

CONFIG_LWIP_IPV6_AUTOCONFIG=y

# Custom partition table: reserves esp_secure_cert and fctry partitions per
# this project's already-decided Matter identity architecture (see
# docs/matter-identity-and-certification.md), even though this build uses
# the SDK's compiled-in test credentials rather than a provisioned fctry image.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y

# This project's own app only creates one dynamic endpoint (the on/off light),
# but this value can't just be 1: esp_matter_bridge is pulled into the build
# unconditionally (it lives under esp-matter/components/, on this project's
# component search path) even though this PoC never calls into it, and its
# MAX_BRIDGED_DEVICE_COUNT macro is compile-time sized as
# (CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT - 1 [root endpoint] -
# CONFIG_ESP_MATTER_AGGREGATOR_ENDPOINT_COUNT). CONFIG_ESP_MATTER_AGGREGATOR_
# ENDPOINT_COUNT's own Kconfig range is 1-5 (esp_matter_bridge/Kconfig), so it
# can never be lowered to 0 to work around this. 1 (root) + 1 (mandatory
# minimum aggregator) + 1 spare = 3 is the minimum that keeps that unused
# component's arithmetic non-negative; confirmed against
# espressif/esp-matter's components/esp_matter_bridge/esp_matter_bridge.h and
# Kconfig. There is no supported ESP-IDF mechanism (EXCLUDE_COMPONENTS is not
# real; COMPONENTS is an allowlist that would require enumerating this whole
# dependency graph by hand) to exclude the unused component from the build
# instead, so this padding is the actual fix, not a workaround for one.
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=3

CONFIG_MBEDTLS_HKDF_C=y

# Unique local addresses for fabrics + a link-local address.
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

# Exclude unused clusters to optimize flash and memory usage. This project
# only creates an on_off_light endpoint (OnOff, Identify, Descriptor,
# Groups, Scenes Management), so none of the clusters below are referenced
# by this code either way. Copied verbatim from the upstream example rather
# than trimmed by hand: omitting this block risks the firmware image
# exceeding the ota_0 partition size on the 4MB flash (the upstream README
# only got to 1.26MB *with* this exclusion list applied), which would only
# surface as a build/flash failure, not something worth risking on a first
# build. If it turns out some of these are still pulled in transitively and
# needed, `idf.py menuconfig` -> Component config -> CHIP Device Layer ->
# Device Identification / Matter clusters is where to re-enable one.
CONFIG_SUPPORT_ACCOUNT_LOGIN_CLUSTER=n
CONFIG_SUPPORT_ACTIONS_CLUSTER=n
CONFIG_SUPPORT_ACTIVATED_CARBON_FILTER_MONITORING_CLUSTER=n
CONFIG_SUPPORT_AIR_QUALITY_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_BASIC_CLUSTER=n
CONFIG_SUPPORT_APPLICATION_LAUNCHER_CLUSTER=n
CONFIG_SUPPORT_AUDIO_OUTPUT_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CLUSTER=n
CONFIG_SUPPORT_BOOLEAN_STATE_CONFIGURATION_CLUSTER=n
CONFIG_SUPPORT_BRIDGED_DEVICE_BASIC_INFORMATION_CLUSTER=n
CONFIG_SUPPORT_CAMERA_AV_SETTINGS_USER_LEVEL_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_DIOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CARBON_MONOXIDE_CONCENTRATION_MEASUREMENT_CLUSTER=n
CONFIG_SUPPORT_CHANNEL_CLUSTER=n
CONFIG_SUPPORT_CHIME_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_CONTROL_CLUSTER=n
CONFIG_SUPPORT_CLOSURE_DIMENSION_CLUSTER=n
CONFIG_SUPPORT_COMMISSIONER_CONTROL_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_METERING_CLUSTER=n
