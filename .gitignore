# ---------------------------------------------------------------------------
# TYWE2L-2-THREAD
# Public repository. Assume everything not ignored here will be published.
# ---------------------------------------------------------------------------

# --- Secrets and per-device credentials ------------------------------------
# Matter DACs, passcodes, discriminators and signing keys must never be
# committed. Test credentials are regenerated by the tooling, not stored.
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.der
*.p12
*.pfx
*.jks
*.keystore
*_rsa
*_ecdsa
*.minisign
*.sec
esp_secure_cert/
fctry/
mfg_out/
**/matter_credentials/

# --- Third-party hardware reverse engineering --------------------------------
# Photos, teardown notes and board dumps of commercial host devices (e.g. the
# Connect SmartHome downlights). Not our IP to publish; local-only working
# material for the leg-reversing effort.
hardware/smarthome/

# --- KiCad ------------------------------------------------------------------
*-backups/
*.kicad_prl
*.kicad_sch-bak
*.kicad_pcb-bak
*.bak
_autosave-*
~*.lck
*.lck
fp-info-cache
*.dsn
*.ses
*.zip
# Generated fabrication and assembly outputs. Regenerate from source.
hardware/**/gerbers/
hardware/**/fab/
hardware/**/production/
*.gbr
*.drl
*.gbrjob
# 3D model caches
*.wrl.bak

# --- ESP-IDF / firmware -----------------------------------------------------
build/
cmake-build-*/
sdkconfig
sdkconfig.old
!sdkconfig.defaults
!sdkconfig.defaults.*
managed_components/
dependencies.lock
*.elf
*.map
size_report.txt
# EIM (ESP-IDF Installation Manager) local config and pyenv version pin.
# Machine-specific (absolute local paths), not project content.
eim_config.toml
.python-version
# Built images are published deliberately via the installer site, not here.
firmware/**/*.bin

# --- Web installer / registry tooling ---------------------------------------
node_modules/
dist/
build-web/
.parcel-cache/
.vite/
.next/
.cache/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors and OS ---------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*~
# VSCode local-history extension: per-file backups with their own embedded
# .git repo. Editor-local noise, never project content, unsafe to `git add`
# as-is because it nests a second repository.
**/.history/

# --- Agent / assistant tooling ----------------------------------------------
# Local orchestration state, not project content.
.claude-flow/
.hive-mind/
.swarm/
.claude/settings.local.json
# Git worktrees checked out for isolated agent work. Each one is its own
# working copy of this same repo; never commit them into it.
.claude/worktrees/
memory/
scratchpad/

# --- Misc -------------------------------------------------------------------
*.log
tmp/
.tmp/
